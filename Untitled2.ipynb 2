        "# VERİ TEMİZLEME VE RAPORLAMA\n",
        "\n",
        "# Gereksiz sembolleri temizleyip sütunları sayısal değerlere çevir\n",
        "df['discounted_price'] = df['discounted_price'].str.replace('₹', '').str.replace(',', '').astype(float)\n",
        "df['actual_price'] = df['actual_price'].str.replace('₹', '').str.replace(',', '').astype(float)\n",
        "df['discount_percentage'] = df['discount_percentage'].str.replace('%', '').astype(float)\n",
        "df['rating_count'] = df['rating_count'].str.replace(',', '').astype(float)\n",
        "\n",
        "# rating sütunundaki hatalı/metinsel karakterleri NaN yap\n",
        "df['rating'] = pd.to_numeric(df['rating'], errors='coerce')\n",
        "\n",
        "#--RAPORLAMA--\n",
        "print(\"--- Sütunlardaki Toplam Eksik/Hatalı Veri Sayısı ---\")\n",
        "print(df[['rating', 'rating_count', 'discounted_price']].isnull().sum())\n",
        "print(\"-\" * 50)\n",
        "\n",
        "# Eksik ve hatalı satırları SİL\n",
        "df.dropna(subset=['rating', 'rating_count', 'discounted_price'], inplace=True)\n",
        "\n",
        "# hedef değişken\n",
        "df['yuksek_puanli_mi'] = (df['rating'] >= 4.0).astype(int)\n",
        "\n",
        "# kontrol\n",
        "secilen_sutunlar = ['discounted_price', 'actual_price', 'discount_percentage', 'rating_count', 'rating', 'yuksek_puanli_mi']\n",
        "print(\"--- TEMİZLİK SONRASI: İlk 5 Satır Görüntüsü ---\")\n",
        "display(df[secilen_sutunlar].head())"
