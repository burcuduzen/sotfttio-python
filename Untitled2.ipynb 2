        "from sklearn.model_selection import GridSearchCV\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import confusion_matrix, classification_report\n",
        "\n",
        "#Denemek istediğimiz parametre seçeneklerini (Grid) belirle\n",
        "param_grid = {\n",
        "    'n_estimators': [50, 100, 150],       # Ağaç sayısı\n",
        "    'max_depth': [5, 10, None],            # Ağaçların maksimum derinlik sınırları\n",
        "    'criterion': ['gini', 'entropy']       # Dallanma kalitesini\n",
        "}\n",
        "\n",
        "#Temel modelimizi tanımla\n",
        "rf_base = RandomForestClassifier(class_weight='balanced', random_state=42)\n",
        "\n",
        "# GridSearchCV\n",
        "# cv=3: Veriyi 3 farklı kombinasyonda katlayarak test et (3-Fold Cross Validation)\n",
        "grid_search = GridSearchCV(estimator=rf_base, param_grid=param_grid, cv=3, scoring='f1', n_jobs=-1)\n",
        "\n",
        "print(\"En iyi parametreler aranıyor ...\")\n",
        "grid_search.fit(X_train_scaled, y_train)\n",
        "\n",
        "# En iyi kombinasyonu ekrana yazdır\n",
        "print(\"\\n--- Bulunan En İyi Parametreler ---\")\n",
        "print(grid_search.best_params_)\n",
        "\n",
        "#Bu en iyi model ile test verimiz üzerinde nihai tahmini yapıyoruz\n",
        "en_iyi_model = grid_search.best_estimator_\n",
        "grid_y_pred = en_iyi_model.predict(X_test_scaled)\n",
        "\n",
        "#sonuçlar\n",
        "grid_cm = confusion_matrix(y_test, grid_y_pred)\n",
        "print(\"\\n--- GRIDSEARCH SONRASI EN İYİ MODEL MATRİSİ ---\")\n",
        "print(\"                 [Tahmin 0]  [Tahmin 1]\")\n",
        "print(f\"[Gerçekte 0]      {grid_cm[0][0]}          {grid_cm[0][1]}\")\n",
        "print(f\"[Gerçekte 1]      {grid_cm[1][0]}          {grid_cm[1][1]}\\n\")\n",
        "\n",
        "print(\"--- En İyi Model Sınıflandırma Raporu ---\")\n",
